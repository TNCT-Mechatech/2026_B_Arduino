//============================================================
// Leonardo 仮テストプログラム
//
// Raspberry Pi → Leonardo
//
// joyX     : int16_t
// joyY     : int16_t
// joyRot   : int16_t
// buttonA  : uint8_t
// buttonB  : uint8_t
//
// 合計 8Byte
//
// A/Bは受信確認のみ
// 射出モーターは安全のため停止状態
//============================================================

#include <Arduino.h>
#include <math.h>

#include <SerialBridge.hpp>
#include <InoHardwareSerial.hpp>

#include "Motor.h"


//============================================================
// Raspberry Piと同じ構造体
//============================================================

typedef struct
{
    int16_t joyX;
    int16_t joyY;
    int16_t joyRot;

    uint8_t buttonA;
    uint8_t buttonB;

} JoyData_t;


//============================================================
// SerialBridge
//============================================================

sb::Message<JoyData_t> joy_msg;

InoHardwareSerial serial(&Serial);

SerialBridge bridge(&serial);


//============================================================
// オムニモータ ピン
//============================================================

const int dirPin  = 2;
const int pwmPin  = 3;

const int dirPin2 = 5;
const int pwmPin2 = 6;

const int dirPin3 = 8;
const int pwmPin3 = 9;

const int dirPin4 = 10;
const int pwmPin4 = 11;


//============================================================
// 射出モータ ピン
//============================================================

const int dirPin5 = 12;
const int pwmPin5 = 13;


//============================================================
// 射出モータ
//============================================================

Motor shotMotor(
    pwmPin5,
    dirPin5
);


//============================================================
// ジョイスティック
//============================================================

int joyX = 0;
int joyY = 0;
int joyRot = 0;


//============================================================
// ボタン
//============================================================

uint8_t buttonA = 0;
uint8_t buttonB = 0;


//============================================================
// オムニ制御
//============================================================

float omega = 0.0;
float r = 0.0;
float theta = 0.0;

float ROT_GAIN = 0.6;

float MOVE_CURVE = 3.0f;
float ROT_CURVE  = 3.0f;


//============================================================
// エンコーダ
//============================================================

volatile int32_t encoder_count = 0;


//============================================================
// 入力カーブ
//============================================================

float curveInput(
    float input,
    float exponent)
{
    return copysign(
        pow(abs(input), exponent),
        input
    );
}


//============================================================
// setup
//============================================================

void setup()
{
    //========================================================
    // Raspberry Pi通信
    //========================================================

    Serial.begin(230400);

    bridge.add_frame(
        0,
        &joy_msg
    );


    //========================================================
    // オムニモータ
    //========================================================

    pinMode(pwmPin, OUTPUT);
    pinMode(pwmPin2, OUTPUT);
    pinMode(pwmPin3, OUTPUT);
    pinMode(pwmPin4, OUTPUT);

    pinMode(dirPin, OUTPUT);
    pinMode(dirPin2, OUTPUT);
    pinMode(dirPin3, OUTPUT);
    pinMode(dirPin4, OUTPUT);


    //========================================================
    // 射出モータ
    //========================================================

    shotMotor.begin();

    // 仮テストでは必ず停止
    shotMotor.stop();


    //========================================================
    // 初期値
    //========================================================

    joyX = 0;
    joyY = 0;
    joyRot = 0;

    buttonA = 0;
    buttonB = 0;


    //========================================================
    // 通信確認
    //========================================================

    Serial.println(
        "Leonardo test program started"
    );
}


//============================================================
// loop
//============================================================

void loop()
{
    //========================================================
    // Raspberry Piから受信
    //========================================================

    bridge.update();


    //========================================================
    // 新しいデータ
    //========================================================

    if (joy_msg.was_updated())
    {
        //======================================================
        // ジョイスティック
        //======================================================

        joyX =
            joy_msg.data.joyX;

        joyY =
            joy_msg.data.joyY;

        joyRot =
            joy_msg.data.joyRot;


        //======================================================
        // A / B
        //======================================================

        buttonA =
            joy_msg.data.buttonA;

        buttonB =
            joy_msg.data.buttonB;


        //======================================================
        // シリアル確認
        //======================================================

        Serial.print("X=");
        Serial.print(joyX);

        Serial.print(" Y=");
        Serial.print(joyY);

        Serial.print(" ROT=");
        Serial.print(joyRot);

        Serial.print(" A=");
        Serial.print(buttonA);

        Serial.print(" B=");
        Serial.println(buttonB);


        //======================================================
        // 仮テスト
        //
        // A/Bを受信しても射出モータは動かさない
        //======================================================

        shotMotor.stop();
    }


    //========================================================
    // ジョイスティック入力
    //========================================================

    float inputX =
        joyX / 255.0f;

    float inputY =
        joyY / 255.0f;

    float inputRot =
        joyRot / 255.0f;


    //========================================================
    // 移動量
    //========================================================

    r =
        sqrt(
            (long)joyX * joyX +
            (long)joyY * joyY
        );


    theta =
        atan2(
            joyY,
            joyX
        );


    //========================================================
    // 移動カーブ
    //========================================================

    float moveInput =
        r / 255.0f;

    moveInput =
        pow(
            moveInput,
            MOVE_CURVE
        );

    r =
        moveInput * 255.0f;


    //========================================================
    // 旋回カーブ
    //========================================================

    float rotInput =
        curveInput(
            inputRot,
            ROT_CURVE
        );

    omega =
        rotInput * 255.0f;


    //========================================================
    // オムニ運動学
    //========================================================

    float out1 =
        r * sin(theta + PI / 4.0)
        - ROT_GAIN * omega;


    float out2 =
        -r * cos(theta + PI / 4.0)
        - ROT_GAIN * omega;


    float out3 =
        -r * sin(theta + PI / 4.0)
        - ROT_GAIN * omega;


    float out4 =
        r * cos(theta + PI / 4.0)
        - ROT_GAIN * omega;


    //========================================================
    // スケーリング
    //========================================================

    float maxVal =
        max(
            abs(out1),
            max(
                abs(out2),
                max(
                    abs(out3),
                    abs(out4)
                )
            )
        );


    if (maxVal > 255.0)
    {
        float scale =
            255.0 / maxVal;

        out1 *= scale;
        out2 *= scale;
        out3 *= scale;
        out4 *= scale;
    }


    //========================================================
    // オムニモータ出力
    //========================================================

    drive(
        (int)out1,
        (int)out2,
        (int)out3,
        (int)out4
    );


    //========================================================
    // エンコーダ
    //========================================================

    noInterrupts();

    int32_t encoder =
        encoder_count;

    interrupts();


    uint8_t tx_buf[4];

    tx_buf[0] =
        (encoder >> 24) & 0xFF;

    tx_buf[1] =
        (encoder >> 16) & 0xFF;

    tx_buf[2] =
        (encoder >> 8) & 0xFF;

    tx_buf[3] =
        encoder & 0xFF;


    //========================================================
    // 周期
    //========================================================

    delay(5);
}


//============================================================
// オムニモータ drive
//============================================================

void drive(
    int out1,
    int out2,
    int out3,
    int out4)
{
    //========================================================
    // PWM
    //========================================================

    analogWrite(
        pwmPin,
        abs(out1)
    );

    analogWrite(
        pwmPin2,
        abs(out2)
    );

    analogWrite(
        pwmPin3,
        abs(out3)
    );

    analogWrite(
        pwmPin4,
        abs(out4)
    );


    //========================================================
    // DIR
    //========================================================

    digitalWrite(
        dirPin,
        out1 >= 0
            ? HIGH
            : LOW
    );

    digitalWrite(
        dirPin2,
        out2 >= 0
            ? HIGH
            : LOW
    );

    digitalWrite(
        dirPin3,
        out3 >= 0
            ? HIGH
            : LOW
    );

    digitalWrite(
        dirPin4,
        out4 >= 0
            ? HIGH
            : LOW
    );
}